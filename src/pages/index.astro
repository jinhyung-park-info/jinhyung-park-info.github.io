---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getProfile, getPosts, getProjects, getPublications, formatDate } from '../lib/content';
import Publication from '../components/Publication.astro';
import ProjectItem from '../components/ProjectItem.astro';

const profile = await getProfile();
const { Content } = await render(profile);
const { name, headline, tagline, location, photo, interests, email, links } = profile.data;

const posts = (await getPosts()).slice(0, 5);
// Items marked "Show on home page" in /admin (featured / selected).
// If nothing is marked, the top three are shown so the section never disappears.
const pick = <T,>(items: T[], marked: (item: T) => boolean) =>
  items.some(marked) ? items.filter(marked) : items.slice(0, 3);
const featured = pick(await getProjects(), (p) => p.data.featured);
const selectedPubs = pick(await getPublications(), (p) => p.data.selected);
---

<Base>
  <section class="hero">
    <aside class="hero-side">
      {photo ? (
        <img class="avatar" src={photo} alt={name} width="600" height="600" />
      ) : (
        <div class="avatar avatar-empty" aria-hidden="true">{name.split(' ').map((w) => w[0]).join('')}</div>
      )}
      {location && <p class="faint small hero-location">{location}</p>}
      <div class="hero-links small">
        {email && <a href={`mailto:${email}`}>Email</a>}
        {links.map((l) => <a href={l.url} target="_blank" rel="me noopener">{l.label}</a>)}
        <a href="/experience">CV</a>
      </div>
    </aside>

    <div class="hero-main">
      <p class="lead hero-headline">
        <strong>{headline}</strong>
        {tagline && <span>{tagline}</span>}
      </p>
      <div class="prose">
        <Content />
      </div>
      {interests.length > 0 && (
        <ul class="tags" aria-label="Interests">
          {interests.map((i) => <li class="tag">{i}</li>)}
        </ul>
      )}
    </div>
  </section>

  <h2 class="section-title">Recent writing</h2>
  {posts.length > 0 ? (
    <div>
      {posts.map((post) => (
        <div class="post-row">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span>
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
            {post.data.hidden && <span class="pill-hidden">hidden</span>}
          </span>
        </div>
      ))}
      <p class="small" style="margin-top:10px"><a href="/blog">All posts →</a></p>
    </div>
  ) : (
    <p class="muted small">Posts are on the way.</p>
  )}

  {featured.length > 0 && (
    <>
      <h2 class="section-title">Projects</h2>
      <ul class="entry-list">
        {featured.map((project) => <ProjectItem project={project} />)}
      </ul>
      <p class="small"><a href="/projects">All projects →</a></p>
    </>
  )}

  {selectedPubs.length > 0 && (
    <>
      <h2 class="section-title">Publications</h2>
      <ul class="entry-list">
        {selectedPubs.map((pub) => <Publication pub={pub} me={name} />)}
      </ul>
      <p class="small"><a href="/publications">All publications →</a></p>
    </>
  )}
</Base>
